              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const c = pm.response.json().challenge;",
                  "pm.collectionVariables.set('challengeId', c.challengeId);",
                  "pm.collectionVariables.set('question', c.question);",
                  "pm.collectionVariables.set('wrongOption', c.options.find(o => o !== c.question));",
                  "pm.test('4 unique options, no correctOption', () => { pm.expect(new Set(c.options).size).to.eql(4); pm.expect(JSON.stringify(c).toLowerCase()).to.not.include('correctoption'); });"
                ]
              }
