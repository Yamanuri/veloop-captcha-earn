        {
          "name": "Get CAPTCHA",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const c = pm.response.json().challenge;",
                  "pm.collectionVariables.set('challengeId', c.challengeId);",
                  "pm.collectionVariables.set('question', c.question);",
                  "pm.collectionVariables.set('wrongOption', c.options.find(o => o !== c.question));",
                  "pm.test('4 unique options, no correctOption', () => { pm.expect(new Set(c.options).size).to.eql(4); pm.expect(JSON.stringify(c).toLowerCase()).to.not.include('correctoption'); });",
                  "pm.collectionVariables.set('firstChallengeId', pm.collectionVariables.get('challengeId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/captcha/current",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "captcha",
                "current"
              ]
            }
          }
        },
        {
          "name": "Verify CORRECT",
