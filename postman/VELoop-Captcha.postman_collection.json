              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json(); pm.test('CORRECT +1 credited on verify', () => { pm.expect(j.result).to.eql('CORRECT'); pm.expect(j.reward.amount).to.eql(1); pm.expect(j.balance).to.eql(Number(pm.collectionVariables.get('balanceBefore')) + 1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
