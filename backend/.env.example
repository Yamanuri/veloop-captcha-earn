NODE_ENV=development
PORT=5000
# Local default from the assignment. For Atlas, set your private connection string in backend/.env.
MONGODB_URI=mongodb://127.0.0.1:27017/mydatabase
# Optional alias (MONGODB_URI is preferred)
# MONGO_URI=mongodb://127.0.0.1:27017/mydatabase
# Required. Generate a unique secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Required in production on a replica set / Atlas; production startup refuses false.
# Local standalone MongoDB can use false for development only.
USE_TRANSACTIONS=false
# Reward config defaults (seeded into MongoDB CaptchaRewardConfig)
CAPTCHA_EXPIRY_SECONDS=120
CAPTCHA_DAILY_LIMIT=1000
# Rate limits (requests per window)
RATE_CURRENT_PER_MIN=60
RATE_NEW_PER_MIN=20
RATE_VERIFY_PER_MIN=30
RATE_CLAIM_PER_MIN=20
RATE_HISTORY_PER_MIN=60
RATE_GLOBAL_PER_MIN=300
AUTH_RATE_MAX=20
